.root {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(56, 56, 56);
}

.submenu-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(100, 100, 100);
}

.content-container {
    flex-grow: 1;
    flex-direction: column;
}

.sections-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 25px;
}

.sections-row > .section {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 15px;
    margin-bottom: 0;
}

.section-last {
    margin-right: 0;
}

.section {
    margin-bottom: 25px;
    padding: 15px;
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.section-header {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
}

.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    min-height: 24px;
}

.field-label {
    width: 220px;
    min-width: 220px;
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-left;
    padding-right: 10px;
}

.field-input {
    flex-grow: 1;
    min-width: 200px;
}

.field-input > .unity-base-field__input {
    background-color: rgb(40, 40, 40);
    border-color: rgb(30, 30, 30);
    color: rgb(210, 210, 210);
    padding: 4px;
    border-radius: 3px;
}

.field-input > .unity-base-field__input:hover {
    border-color: rgb(60, 60, 60);
}

.field-input > .unity-base-field__input:focus {
    border-color: rgb(100, 140, 200);
    background-color: rgb(45, 45, 45);
}

.help-box {
    margin-top: 10px;
    padding: 8px;
    background-color: rgba(80, 120, 180, 0.2);
    border-radius: 3px;
}