/* Target the TemplateContainer root */
#FlowchartEditorQolTab_Root {
    height: auto;
    flex-shrink: 0;
}

.editor-qol-tab-container {
    justify-content: center;
    height: auto;
    flex-direction: row;
    flex-shrink: 0;
}

.editor-qol-tab {
    color: rgb(222, 222, 222);
    background-color: rgb(60, 60, 60);
    border-color: rgb(30, 30, 30);
    border-width: 1px;
    transition-property: background-color;
    transition-duration: 0.2s;
    width: 100%;
    height: 50px;
    margin: 5px 0px 5px 0px;
}

.editor-qol-tab:hover {
    background-color: rgb(70, 70, 70);
}

.editor-qol-tab:active {
    background-color: rgb(50, 50, 50);
}

.editor-qol-tab.selected {
    background-color: rgb(80, 120, 180);
    border-color: rgb(100, 140, 200);
}