:root
{
    --hyphlow-tab-icon: resource("Editor/Icons/mianeRootTabIcon_aiGen");
}

.tabIcon
{
    background-image: var(--hyphlow-tab-icon);
    -unity-background-scale-mode: scale-to-fit;

    background-position-y: bottom; 
    /* ^Prevents empty space below the icon that wasn't in the source image. */
}

.tabIconHolder
{
    padding: 5px 0px 0px 0px;
    margin: 0px 0px 0px 3px;
    width: 60px;
}

.hyphlow-tab {
    justify-content: center;
    color: rgb(222, 222, 222);
    -unity-text-align: middle-center;
    background-color: rgb(60, 60, 60);
    border-color: rgb(30, 30, 30);
    border-width: 1px;
    transition-property: background-color;
    transition-duration: 0.2s;
    width: 100%;
    padding: 0;
    flex-direction: column;
    height: 60px;
    flex-grow: 0;
}

.hyphlow-tab > Toggle {
    height: 100%;
}

.hyphlow-tab > Toggle > VisualElement {
    height: 100%;
}

/* To hide the checkmark */
.unity-toggle__checkmark
{
    visibility: hidden;
    opacity: 0;
    display: none;
}

.hyphlow-tab > Toggle > VisualElement > Label {
    font-size: 24px;
    flex-grow: 1;
    height: 100%;
    -unity-text-align: middle-center;
}

.hyphlow-tab:hover {
    background-color: rgb(70, 70, 70);
}

.hyphlow-tab:active {
    background-color: rgb(50, 50, 50);
}

.hyphlow-tab.selected {
    background-color: rgb(80, 120, 180);
    border-color: rgb(100, 140, 200);
}
