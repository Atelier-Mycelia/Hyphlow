.icons-hint {
    font-size: 12px;
    color: rgb(160, 160, 160);
    white-space: normal;
    margin-bottom: 12px;
}

.icon-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.icon-row__label {
    width: 220px;
    min-width: 220px;
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-left;
}

.icon-slot {
    align-items: center;
    margin-right: 16px;
}

.icon-slot__label {
    font-size: 10px;
    color: rgb(150, 150, 150);
    margin-top: 2px;
}

.icon-square {
    width: 48px;
    height: 48px;
    padding: 4px;
    background-color: rgb(40, 40, 40);
    border-width: 1px;
    border-color: rgb(30, 30, 30);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

.icon-square:hover {
    border-color: rgb(100, 140, 200);
}

.icon-square:disabled {
    opacity: 0.5;
}

.icon-square--empty {
    border-style: solid;
    border-color: rgb(80, 80, 80);
}

.icon-square__preview {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-square__empty-mark {
    font-size: 20px;
    color: rgb(120, 120, 120);
}
